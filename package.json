{
  "name": "halmahera",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "@t3-oss/env-core": "0.13.11",
      "@t3-oss/env-nextjs": "0.13.11",
      "@cloudflare/workers-types": "^5.20260906.1",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "@hugeicons/core-free-icons": "^4.2.3",
      "@hugeicons/react": "^1.1.9"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "deploy": "turbo run deploy -F @halmahera/infra --",
    "destroy": "turbo run destroy -F @halmahera/infra --",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@halmahera/config": "workspace:*",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "catalog:",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
